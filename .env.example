# .env.example
# Riot API key — get one at https://developer.riotgames.com
# Personal Development keys without a product expire after 24h and must be regenerated.
RIOT_API_KEY=

# Port the server listens on.
PORT=

# Origin(s) allowed to call /api/riot from the browser.
# Use '*' for any origin, a single URL, or a comma-separated list.
ALLOWED_ORIGIN=*
