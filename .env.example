# .env.example
# Riot API key — get one at https://developer.riotgames.com
# Development keys expire after 24h and must be regenerated.
RIOT_API_KEY=

# The Riot ID to track, split into its two parts.
# e.g. for "Faker#KR1" -> RIOT_NAME=Faker, RIOT_TAG=KR1
RIOT_NAME=
RIOT_TAG=

# Platform routing value for the account's region.
# One of: na1, euw1, eun1, kr, jp1, br1, la1, la2, oc1, tr1, ru,
#         ph2, sg2, th2, tw2, vn2
# See: https://developer.riotgames.com/docs/lol#routing-values
RIOT_REGION=euw1

# Port the server listens on.
PORT=4322

# Origin(s) allowed to call /api/riot from the browser.
# Use '*' for any origin, a single URL, or a comma-separated list.
ALLOWED_ORIGIN=*
